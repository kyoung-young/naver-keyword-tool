# ────────────────────────────────────────────────────
# 네이버 검색 API  (순위조회 · 트렌드 · 모니터링)
# https://developers.naver.com/apps/#/register
# ────────────────────────────────────────────────────
NAVER_CLIENT_ID=발급받은_Client_ID
NAVER_CLIENT_SECRET=발급받은_Client_Secret

# ────────────────────────────────────────────────────
# 네이버 검색광고 API  (키워드 분석 · 확장)
# https://searchad.naver.com → 도구 → API 관리
# ────────────────────────────────────────────────────
NAVER_AD_API_KEY=발급받은_API_키
NAVER_AD_SECRET_KEY=발급받은_시크릿_키
NAVER_AD_CUSTOMER_ID=발급받은_고객_ID

# ────────────────────────────────────────────────────
# 모니터링 자동실행 cron 보안 토큰
# Railway Cron Job → /api/cron 호출 시 인증에 사용
# openssl rand -hex 32  등으로 생성 권장
# ────────────────────────────────────────────────────
CRON_SECRET=랜덤하고_긴_비밀문자열
